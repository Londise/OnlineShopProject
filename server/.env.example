# MySQL 8+
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ferchu_modas"
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:5173"
SESSION_COOKIE_NAME="ferchu_session"
SESSION_TTL_DAYS=14

# Used only by `npm run prisma:seed`; never expose these values to the frontend.
ADMIN_NAME="Administrador Ferchu"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-before-seeding"

# Cloudinary: optional until image uploads are enabled in the management UI.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

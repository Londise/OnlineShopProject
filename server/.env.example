# Express + Prisma connect to PostgreSQL; these are not Supabase API keys.
# Runtime: a dedicated LOGIN belonging to the ferchu_backend group.
# Use the exact hostname from Connect > ORM > Prisma > Session pooler (5432),
# or Direct connection if the server can reach IPv6. URL-encode the password.
DATABASE_URL="postgresql://ferchu_api.PROJECT_REF:REPLACE_PASSWORD@SESSION_POOLER_HOST:5432/postgres?schema=app&sslmode=require&connection_limit=5"
# Migrations: a separate owner/admin connection, direct or session mode, NOT 6543.
DIRECT_URL="postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@SESSION_POOLER_HOST:5432/postgres?schema=app&sslmode=require"

NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=ferchu_session
SESSION_TTL_DAYS=14

# Only needed to seed a NEW EMPTY development database. Never seed imported data.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server-only Storage API access. Never prefix the secret with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Production: exact HTTPS frontend origin (without path/trailing slash) and
# a random secret shared ONLY by Render and the Vercel reverse proxy.
# Never prefix this secret with VITE_. Local development may leave it empty.
ORIGIN_PROXY_SECRET=

LOG_LEVEL=info
LOG_DEBUG_SAMPLE=0.1
LOG_BUFFER_MAX=100
LOG_FLUSH_MS=2000
# Hard limits, including queued entries and the active batch:
LOG_QUEUE_MAX_ENTRIES=1000
LOG_QUEUE_MAX_BYTES=2097152
MEDIA_UPLOAD_CONCURRENCY=1

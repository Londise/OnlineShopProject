# Frontend only. No database URLs, Storage secrets or proxy secret in VITE_*.
# Local Vite + Express:
VITE_API_URL=http://localhost:3001/api/v1

# In Vercel Production use VITE_API_URL=/api/v1 (also the production default).
# Vercel-only configuration (not browser variables):
# RENDER_BACKEND_URL=https://YOUR_ACTUAL_RENDER_HOST.onrender.com
# ORIGIN_PROXY_SECRET= (same secret as Render; >=32 chars; set in dashboard)

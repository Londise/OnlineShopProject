{
  "name": "ferchu-modas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:sensitivity": "node scripts/test-sensitivity.mjs",
    "test:build": "node scripts/verify-build.mjs",
    "test:all": "npm test && npm --prefix server test && npm --prefix server run test:harness && npm --prefix server run test:integration && npm run test:e2e && npm run test:build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/functions": "3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "jsdom": "^26.1.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
